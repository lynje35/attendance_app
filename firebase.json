{
  "hosting": {
    "target": "checkin",
    "public": "build/web",
    "headers": [
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/{index.html,flutter_bootstrap.js,main.dart.js,flutter_service_worker.js,manifest.json}",
        "headers": [
          { "key": "Cache-Control", "value": "max-age=0, must-revalidate" }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
